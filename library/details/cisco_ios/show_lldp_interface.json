          "GigabitEthernet1/0/2": {
            "tx_enabled": true,
            "rx_enabled": true,
            "tx_state": "IDLE",
            "rx_state": "WAIT FOR FRAME"
          },
          "GigabitEthernet1/0/3": {
            "tx_enabled": true,
            "rx_enabled": true,
            "tx_state": "INIT",
            "rx_state": "WAIT PORT OPER"
          },
          "GigabitEthernet1/0/4": {
            "tx_enabled": true,
            "rx_enabled": true,
            "tx_state": "INIT",
            "rx_state": "WAIT PORT OPER"
