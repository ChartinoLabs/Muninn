{
  "os": "cisco_ios",
  "command": "show lldp interface",
  "schema": {
    "name": "ShowLldpInterfaceResult",
    "fields": {
      "lldp_enabled": {
        "type": "bool",
        "required": true
      },
      "interfaces": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "InterfaceEntry",
            "fields": {
              "tx_enabled": {
                "type": "bool",
                "required": true
              },
              "rx_enabled": {
                "type": "bool",
                "required": true
              },
              "tx_state": {
                "type": "str",
                "required": true
              },
              "rx_state": {
                "type": "str",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
