{
  "os": "cisco_ios",
  "command": "show ip ssh",
  "schema": {
    "name": "ShowIpSshResult",
    "fields": {
      "ssh_enabled": {
        "type": "bool",
        "required": true
      },
      "version": {
        "type": "str",
        "required": false
      },
      "authentication_methods": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": false
      },
      "authentication_publickey_algorithms": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": false
      },
      "hostkey_algorithms": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": false
      },
      "encryption_algorithms": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": false
      },
      "mac_algorithms": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": false
      },
      "kex_algorithms": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": false
      },
      "authentication_timeout_seconds": {
        "type": "int",
        "required": false
      },
      "authentication_retries": {
        "type": "int",
        "required": false
      },
      "minimum_diffie_hellman_key_size_bits": {
        "type": "int",
        "required": false
      },
      "hostkey": {
        "type": {
          "name": "HostKeyEntry",
          "fields": {
            "name": {
              "type": "str",
              "required": false
            },
            "algorithm": {
              "type": "str",
              "required": false
            },
            "key": {
              "type": "str",
              "required": false
            }
          }
        },
        "required": false
      }
    }
  },
  "examples": [
    {
      "name": "show ip ssh output from a Catalyst 3750-X stack",
      "input": "SSH Enabled - version 2.0\nAuthentication methods:publickey,keyboard-interactive,password\nAuthentication Publickey Algorithms:x509v3-ssh-rsa,ssh-rsa\nHostkey Algorithms:x509v3-ssh-rsa,ssh-rsa\nEncryption\nAlgorithms:aes128-ctr,aes192-ctr,aes256-ctr,aes128-cbc,3des-cbc,aes192-cbc,aes25\n6-cbc\nMAC Algorithms:hmac-sha1,hmac-sha1-96\nAuthentication timeout: 120 secs; Authentication retries: 3\nMinimum expected Diffie Hellman key size : 1024 bits\nIOS Keys in SECSH format(ssh-rsa, base64 encoded): TP-self-signed-2189069696\nssh-rsa <KEY DATA REDACTED>\n",
      "expected": {
        "ssh_enabled": true,
        "version": "2.0",
        "authentication_methods": [
          "publickey",
          "keyboard-interactive",
          "password"
        ],
        "authentication_publickey_algorithms": [
          "x509v3-ssh-rsa",
          "ssh-rsa"
        ],
        "hostkey_algorithms": [
          "x509v3-ssh-rsa",
          "ssh-rsa"
        ],
        "encryption_algorithms": [
          "aes128-ctr",
          "aes192-ctr",
          "aes256-ctr",
          "aes128-cbc",
          "3des-cbc",
          "aes192-cbc",
          "aes256-cbc"
        ],
        "mac_algorithms": [
          "hmac-sha1",
          "hmac-sha1-96"
        ],
        "authentication_timeout_seconds": 120,
        "authentication_retries": 3,
        "minimum_diffie_hellman_key_size_bits": 1024,
        "hostkey": {
          "name": "TP-self-signed-2189069696",
          "algorithm": "ssh-rsa"
        }
      }
    }
  ]
}
