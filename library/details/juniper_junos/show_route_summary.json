              "holddown": {
                "type": "int",
                "required": true
              },
              "hidden": {
                "type": "int",
                "required": true
              },
              "protocols": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "ProtocolEntry",
                    "fields": {
                      "routes": {
                        "type": "int",
                        "required": true
                      },
                      "active": {
                        "type": "int",
                        "required": true
                      }
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
