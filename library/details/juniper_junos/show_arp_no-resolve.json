{
  "os": "juniper_junos",
  "command": "show arp no-resolve",
  "schema": {
    "name": "ShowArpNoResolveResult",
    "fields": {
      "arp_entries": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ArpEntry",
            "fields": {
              "mac_address": {
                "type": "str",
                "required": true
              },
              "interface": {
                "type": "str",
                "required": true
              },
              "flags": {
                "type": "str",
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
