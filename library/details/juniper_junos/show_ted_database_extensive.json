            },
            "inet_nodes": {
              "type": "int",
              "required": true
            }
          }
        },
        "required": false
      },
      "nodes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "NodeEntry",
            "fields": {
              "node_type": {
                "type": "str",
                "required": false
              },
              "age_secs": {
                "type": "int",
                "required": true
              },
              "link_in": {
                "type": "int",
                "required": true
              },
              "link_out": {
                "type": "int",
                "required": true
              },
              "protocol": {
                "type": "str",
                "required": false
              },
              "links": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "LinkEntry",
                    "fields": {
                      "local_address": {
                        "type": "str",
                        "required": true
                      },
                      "remote_address": {
                        "type": "str",
                        "required": true
                      },
                      "local_interface_index": {
                        "type": "int",
                        "required": false
                      },
