                        "type": "str",
                        "required": false
                      },
                      "metric": {
                        "type": "int",
                        "required": false
                      },
                      "static_bw_bps": {
                        "type": "int",
                        "required": false
                      },
                      "reservable_bw_bps": {
                        "type": "int",
                        "required": false
                      },
                      "available_bw_bps": {
                        "type": {
                          "type": "list",
                          "items": "int"
                        },
                        "required": false
                      },
                      "iscd": {
                        "type": {
                          "type": "dict",
                          "key": "str",
                          "value": {
                            "name": "ISCDEntry",
                            "fields": {
                              "switching_type": {
                                "type": "str",
                                "required": false
                              },
                              "encoding_type": {
                                "type": "str",
                                "required": false
                              },
                              "maximum_lsp_bw_bps": {
                                "type": {
                                  "type": "list",
                                  "items": "int"
                                },
                                "required": false
                              }
                            }
                          }
                        },
                        "required": false
                      },
                      "adjacency_sids": {
                        "type": {
                          "type": "dict",
                          "key": "str",
                          "value": {
                            "name": "AdjacencySID",
                            "fields": {
                              "address_family": {
                                "type": "str",
                                "required": true
                              },
                              "flags": {
                                "type": "str",
                                "required": true
                              },
                              "weight": {
                                "type": "int",
                                "required": true
                              }
                            }
                          }
                        },
                        "required": false
                      }
                    }
                  }
                },
                "required": false
              },
              "prefixes": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "PrefixEntry",
                    "fields": {
                      "flags": {
                        "type": "str",
                        "required": false
                      },
                      "prefix_sid": {
                        "type": {
                          "name": "PrefixSID",
                          "fields": {
                            "sid": {
                              "type": "int",
                              "required": true
                            },
                            "flags": {
                              "type": "str",
                              "required": true
                            },
                            "algorithm": {
                              "type": "int",
                              "required": true
                            }
                          }
                        },
                        "required": false
                      }
                    }
                  }
                },
                "required": false
              },
              "srgb_blocks": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "SRGBBlock",
                    "fields": {
                      "range": {
                        "type": "int",
                        "required": true
                      },
                      "flags": {
                        "type": "str",
                        "required": true
                      }
                    }
                  }
                },
                "required": false
              },
              "spring_algorithms": {
                "type": {
                  "type": "list",
                  "items": "int"
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
