{
  "os": "juniper_junos",
  "command": "show bgp summary",
  "schema": {
    "name": "ShowBgpSummaryResult",
    "fields": {
      "threading_mode": {
        "type": "str",
        "required": false
      },
      "groups": {
        "type": "int",
        "required": true
      },
      "peers": {
        "type": "int",
        "required": true
      },
      "down_peers": {
        "type": "int",
        "required": true
      },
      "tables": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "TableEntry",
            "fields": {
              "total_paths": {
                "type": "int",
                "required": true
              },
              "active_paths": {
                "type": "int",
                "required": true
              },
              "suppressed": {
                "type": "int",
                "required": true
              },
              "history": {
                "type": "int",
                "required": true
              },
              "damp_state": {
                "type": "int",
                "required": true
              },
              "pending": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": false
      },
      "neighbors": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "PeerEntry",
            "fields": {
              "peer_as": {
                "type": "int",
                "required": true
              },
              "in_pkt": {
                "type": "int",
                "required": true
              },
              "out_pkt": {
                "type": "int",
                "required": true
              },
              "out_queue": {
                "type": "int",
                "required": true
              },
              "flaps": {
                "type": "int",
                "required": true
              },
              "last_up_down": {
                "type": "str",
                "required": true
              },
              "state": {
                "type": "str",
                "required": true
              },
              "ribs": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "RibPrefixEntry",
                    "fields": {
                      "active": {
                        "type": "int",
                        "required": true
                      },
                      "received": {
                        "type": "int",
                        "required": true
                      },
                      "accepted": {
                        "type": "int",
                        "required": true
                      },
                      "damped": {
                        "type": "int",
                        "required": true
                      }
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
