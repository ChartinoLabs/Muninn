        "flow_detection": false,
        "logging": true,
        "policer_violation_report_rate": 100,
        "flow_report_rate": 100,
        "default_flow_detection_mode": "Automatic",
        "default_flow_level_detection_mode": "Automatic",
        "default_flow_level_control_mode": "Drop",
        "currently_violated_packet_types": 0,
        "packet_types_have_seen_violations": 0,
