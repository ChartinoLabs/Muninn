{
  "os": "juniper_junos",
  "command": "show ospf neighbor",
  "schema": {
    "name": "ShowOspfNeighborResult",
    "fields": {
      "neighbors": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "OspfNeighborEntry",
            "fields": {
              "address": {
                "type": "str",
                "required": true
              },
              "interface": {
                "type": "str",
                "required": true
              },
              "state": {
                "type": "str",
                "required": true
              },
              "neighbor_id": {
                "type": "str",
                "required": true
              },
              "priority": {
                "type": "int",
                "required": true
              },
              "dead_time": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Two OSPF neighbors on separate interfaces",
      "input": "Address          Interface              State     ID               Pri  Dead\n10.1.2.2         ge-0/0/2.0             Full      2.2.2.2            1    37\n10.1.3.3         ge-0/0/3.0             Full      3.3.3.3            1    31\n\n{master:0}\n",
      "expected": {
        "neighbors": {
          "10.1.2.2": {
            "address": "10.1.2.2",
            "interface": "ge-0/0/2.0",
            "state": "Full",
            "neighbor_id": "2.2.2.2",
            "priority": 1,
            "dead_time": 37
          },
          "10.1.3.3": {
            "address": "10.1.3.3",
            "interface": "ge-0/0/3.0",
            "state": "Full",
            "neighbor_id": "3.3.3.3",
            "priority": 1,
            "dead_time": 31
          }
        }
      }
    },
    {
      "name": "Three OSPF neighbors with mixed priorities and command echo",
      "input": "\n        show ospf neighbor\n        Address          Interface              State     ID               Pri  Dead\n        10.189.5.94      ge-0/0/0.0             Full      10.189.5.253     128    32\n        10.169.14.121   ge-0/0/1.0             Full      10.169.14.240   128    33\n        10.19.198.26     ge-0/0/2.0             Full      10.19.198.239      1    33\n",
      "expected": {
        "neighbors": {
          "10.189.5.94": {
            "address": "10.189.5.94",
            "interface": "ge-0/0/0.0",
            "state": "Full",
            "neighbor_id": "10.189.5.253",
            "priority": 128,
            "dead_time": 32
          },
          "10.169.14.121": {
            "address": "10.169.14.121",
            "interface": "ge-0/0/1.0",
            "state": "Full",
            "neighbor_id": "10.169.14.240",
            "priority": 128,
            "dead_time": 33
          },
          "10.19.198.26": {
            "address": "10.19.198.26",
            "interface": "ge-0/0/2.0",
            "state": "Full",
            "neighbor_id": "10.19.198.239",
            "priority": 1,
            "dead_time": 33
          }
        }
      }
    }
  ]
}
