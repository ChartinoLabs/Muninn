{
  "os": "linux",
  "command": "ip route show",
  "schema": null,
  "examples": [
    {
      "name": "Mixed routes with multiple defaults, ECMP, onlink, linkdown flags",
      "input": "default via 10.0.0.4 dev brblue\ndefault via 10.0.0.4 dev brblue onlink\n10.0.0.0/24 dev brblue proto kernel scope link src 10.0.0.1\n192.168.0.0/24 via 10.0.0.2 dev brblue\n192.168.131.2 dev ens32 proto dhcp scope link src 192.168.131.128 metric 100\n192.168.1.0/24 dev vmbr0  proto kernel  scope link  src 192.168.1.1\n192.168.1.0/24 dev eno2 proto kernel scope link src 192.168.1.3 linkdown\ndefault via 10.10.10.1 dev vmbr0 proto kernel onlink\n",
      "expected": {
        "default": {
          "network": "default",
          "next_hops": [
            {
              "nexthop_if": "brblue",
              "nexthop_ip": "10.0.0.4"
            },
            {
              "nexthop_if": "brblue",
              "nexthop_ip": "10.0.0.4",
              "flags": [
                "onlink"
              ]
            },
            {
              "nexthop_if": "vmbr0",
              "nexthop_ip": "10.10.10.1",
              "protocol": "kernel",
              "flags": [
                "onlink"
              ]
            }
          ]
        },
        "10.0.0.0/24": {
          "network": "10.0.0.0/24",
          "next_hops": [
            {
              "nexthop_if": "brblue",
              "protocol": "kernel",
              "scope": "link",
              "src": "10.0.0.1"
            }
          ]
        },
        "192.168.0.0/24": {
          "network": "192.168.0.0/24",
          "next_hops": [
            {
              "nexthop_if": "brblue",
              "nexthop_ip": "10.0.0.2"
            }
          ]
        },
        "192.168.131.2": {
          "network": "192.168.131.2",
          "next_hops": [
            {
              "nexthop_if": "ens32",
              "protocol": "dhcp",
              "scope": "link",
              "src": "192.168.131.128",
              "metric": 100
            }
          ]
        },
        "192.168.1.0/24": {
          "network": "192.168.1.0/24",
          "next_hops": [
            {
              "nexthop_if": "vmbr0",
              "protocol": "kernel",
              "scope": "link",
              "src": "192.168.1.1"
            },
            {
              "nexthop_if": "eno2",
              "protocol": "kernel",
              "scope": "link",
              "src": "192.168.1.3",
              "flags": [
                "linkdown"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Routes with linkdown flags and DHCP protocol",
      "input": "default via 192.168.1.1 dev enp0s25 proto dhcp src 192.168.1.19 metric 100\n192.168.1.0/24 dev enp0s25 proto kernel scope link src 192.168.1.19 metric 100\n192.168.88.0/24 dev br0 proto kernel scope link src 192.168.88.254 metric 425 linkdown\n192.168.122.0/24 dev virbr0 proto kernel scope link src 192.168.122.1 linkdown\n",
      "expected": {
        "default": {
          "network": "default",
          "next_hops": [
            {
              "nexthop_if": "enp0s25",
              "nexthop_ip": "192.168.1.1",
              "protocol": "dhcp",
              "src": "192.168.1.19",
              "metric": 100
            }
          ]
        },
        "192.168.1.0/24": {
          "network": "192.168.1.0/24",
          "next_hops": [
            {
              "nexthop_if": "enp0s25",
              "protocol": "kernel",
              "scope": "link",
              "src": "192.168.1.19",
              "metric": 100
            }
          ]
        },
        "192.168.88.0/24": {
          "network": "192.168.88.0/24",
          "next_hops": [
            {
              "nexthop_if": "br0",
              "protocol": "kernel",
              "scope": "link",
              "src": "192.168.88.254",
              "metric": 425,
              "flags": [
                "linkdown"
              ]
            }
          ]
        },
        "192.168.122.0/24": {
          "network": "192.168.122.0/24",
          "next_hops": [
            {
              "nexthop_if": "virbr0",
              "protocol": "kernel",
              "scope": "link",
              "src": "192.168.122.1",
              "flags": [
                "linkdown"
              ]
            }
          ]
        }
      }
    }
  ]
}
