{
  "os": "linux",
  "command": "top",
  "schema": {
    "name": "TopResult",
    "fields": {
      "current_time": {
        "type": "str",
        "required": true
      },
      "uptime": {
        "type": "str",
        "required": true
      },
      "users": {
        "type": "int",
        "required": true
      },
      "load_avg_1": {
        "type": "float",
        "required": true
      },
      "load_avg_5": {
        "type": "float",
        "required": true
      },
      "load_avg_15": {
        "type": "float",
        "required": true
      },
      "tasks": {
        "type": {
          "name": "TasksSummary",
          "fields": {
            "total": {
              "type": "int",
              "required": true
            },
            "running": {
              "type": "int",
              "required": true
            },
            "sleeping": {
              "type": "int",
              "required": true
            },
            "stopped": {
              "type": "int",
              "required": true
            },
            "zombie": {
              "type": "int",
              "required": true
            }
          }
        },
        "required": true
      },
      "cpu": {
        "type": {
          "name": "CpuSummary",
          "fields": {
            "user": {
              "type": "float",
              "required": true
            },
            "system": {
              "type": "float",
              "required": true
            },
            "nice": {
              "type": "float",
              "required": true
            },
            "idle": {
              "type": "float",
              "required": true
            },
            "io_wait": {
              "type": "float",
              "required": true
            },
            "hardware_irq": {
              "type": "float",
              "required": true
            },
            "software_irq": {
              "type": "float",
              "required": true
            },
            "steal": {
              "type": "float",
              "required": true
            }
          }
        },
        "required": true
      },
      "memory": {
        "type": {
          "name": "MemorySummary",
          "fields": {
            "total": {
              "type": "float",
              "required": true
            },
            "free": {
              "type": "float",
              "required": true
            },
            "used": {
              "type": "float",
              "required": true
            },
            "buff_cache": {
              "type": "float",
              "required": true
            }
          }
        },
        "required": true
      },
      "swap": {
        "type": {
          "name": "SwapSummary",
          "fields": {
            "total": {
              "type": "float",
              "required": true
            },
            "free": {
              "type": "float",
              "required": true
            },
            "used": {
              "type": "float",
              "required": true
            },
            "avail_mem": {
              "type": "float",
              "required": true
            }
          }
        },
        "required": true
      },
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "user": {
                "type": "str",
                "required": true
              },
              "priority": {
                "type": "str",
                "required": true
              },
              "nice": {
                "type": "int",
                "required": true
              },
              "virtual_mem": {
                "type": "str",
                "required": true
              },
              "resident_mem": {
                "type": "int",
                "required": true
              },
              "shared_mem": {
                "type": "int",
                "required": true
              },
              "status": {
                "type": "str",
                "required": true
              },
              "cpu_percent": {
                "type": "float",
                "required": true
              },
              "mem_percent": {
                "type": "float",
                "required": true
              },
              "time": {
                "type": "str",
                "required": true
              },
              "command": {
                "type": "str",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
