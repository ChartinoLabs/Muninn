{
  "os": "cisco_iosxe",
  "command": "show ip ospf database nssa-external",
  "schema": {
    "name": "ShowIpOspfDatabaseNssaExternalResult",
    "fields": {
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "areas": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "AreaEntry",
                    "fields": {
                      "lsas": {
                        "type": {
                          "type": "dict",
                          "key": "str",
                          "value": {
                            "type": "dict",
                            "key": "str",
                            "value": {
                              "name": "NssaExternalLsaEntry",
                              "fields": {
                                "ls_age": {
                                  "type": "int",
                                  "required": true
                                },
                                "options": {
                                  "type": "str",
                                  "required": true
                                },
                                "ls_type": {
                                  "type": "str",
                                  "required": true
                                },
                                "link_state_id": {
                                  "type": "str",
                                  "required": true
                                },
                                "advertising_router": {
                                  "type": "str",
                                  "required": true
                                },
                                "ls_seq_number": {
                                  "type": "str",
                                  "required": true
                                },
                                "checksum": {
                                  "type": "str",
                                  "required": true
                                },
                                "length": {
                                  "type": "int",
                                  "required": true
                                },
                                "network_mask": {
                                  "type": "str",
                                  "required": true
                                },
                                "metric_type": {
                                  "type": "int",
                                  "required": false
                                },
                                "tos": {
                                  "type": "int",
                                  "required": false
                                },
                                "metric": {
                                  "type": "int",
                                  "required": false
                                },
                                "forward_address": {
                                  "type": "str",
                                  "required": false
                                },
                                "external_route_tag": {
                                  "type": "int",
                                  "required": false
                                }
                              }
                            }
                          }
                        },
                        "required": true
                      }
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Multiple OSPF processes with empty NSSA external databases",
      "input": "OSPF Router with ID (192.0.2.3) (Process ID 1)\n\n            OSPF Router with ID (203.0.113.3) (Process ID 20)\n\n            OSPF Router with ID (198.51.100.3) (Process ID 10)\n",
      "expected": {
        "processes": {
          "1": {
            "router_id": "192.0.2.3",
            "areas": {}
          },
          "20": {
            "router_id": "203.0.113.3",
            "areas": {}
          },
          "10": {
            "router_id": "198.51.100.3",
            "areas": {}
          }
        }
      }
    }
  ]
}
