                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "show ip sla summary output from TAC-R2 with no IP SLA operations configured (header-only table)",
      "input": "IPSLAs Latest Operation Summary\nCodes: * active, ^ inactive, ~ pending\nAll Stats are in milliseconds. Stats with u are in microseconds\n\nID           Type        Destination       Stats       Return      Last\n                                                       Code        Run\n-----------------------------------------------------------------------\n",
      "expected": {
