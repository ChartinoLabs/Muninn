            "contact_persons_email_address": {
              "type": "str",
              "required": false
            },
            "contact_persons_phone_number": {
              "type": "str",
              "required": false
            },
            "street_address": {
              "type": "str",
              "required": false
            },
            "customer_id": {
              "type": "str",
              "required": false
            },
