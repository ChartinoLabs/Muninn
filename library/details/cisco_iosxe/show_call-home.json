                    "type": "str",
                    "required": false
                  }
                }
              },
              "required": false
            },
            "http_resolve_hostname": {
              "type": "str",
              "required": false
            },
            "diagnostic_signature": {
              "type": "str",
              "required": false
            },
            "smart_licensing_messages": {
              "type": "str",
              "required": false
            },
            "aaa_authorization": {
              "type": "str",
              "required": false
            },
            "aaa_authorization_username": {
              "type": "str",
              "required": false
            },
            "data_privacy": {
              "type": "str",
              "required": false
            },
            "syslog_throttling": {
              "type": "str",
              "required": false
