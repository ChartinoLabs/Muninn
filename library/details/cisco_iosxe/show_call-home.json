              "state": {
                "type": {
                  "type": "literal",
                  "values": [
                    "enable",
                    "disable"
                  ]
                },
                "required": true
              },
              "description": {
                "type": "str",
                "required": true
              }
            }
          }
        },
        "required": true
      },
      "profiles": {
