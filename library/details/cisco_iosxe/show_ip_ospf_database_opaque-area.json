{
  "os": "cisco_iosxe",
  "command": "show ip ospf database opaque-area",
  "schema": {
    "name": "ShowIpOspfDatabaseOpaqueAreaResult",
    "fields": {
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "sections": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "type": "list",
                    "items": {
                      "name": "LsaTypeSection",
                      "fields": {
                        "area": {
                          "type": "str",
                          "required": true
                        },
                        "lsas": {
                          "type": {
                            "type": "dict",
                            "key": "str",
                            "value": {
                              "type": "dict",
                              "key": "str",
                              "value": {
                                "name": "OpaqueAreaLsaEntry",
                                "fields": {
                                  "adv_router": {
                                    "type": "str",
                                    "required": true
                                  },
                                  "age": {
                                    "type": "int",
                                    "required": true
                                  },
                                  "seq": {
                                    "type": "str",
                                    "required": true
                                  },
                                  "checksum": {
                                    "type": "str",
                                    "required": true
                                  },
                                  "opaque_id": {
                                    "type": "int",
                                    "required": false
                                  }
                                }
                              }
                            }
                          },
                          "required": true
                        }
                      }
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Empty opaque-area database with multiple OSPF processes",
      "input": "OSPF Router with ID (192.0.2.3) (Process ID 1)\n\n            OSPF Router with ID (203.0.113.3) (Process ID 20)\n\n            OSPF Router with ID (198.51.100.3) (Process ID 10)\n",
      "expected": {
        "processes": {
          "1": {
            "router_id": "192.0.2.3"
          },
          "20": {
            "router_id": "203.0.113.3"
          },
          "10": {
            "router_id": "198.51.100.3"
          }
        }
      }
    }
  ]
}
