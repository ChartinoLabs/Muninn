{
  "os": "cisco_iosxe",
  "command": "show crypto eli all",
  "schema": {
    "name": "ShowCryptoEliAllResult",
    "fields": {
      "hardware_encryption": {
        "type": "str",
        "required": true
      },
      "number_of_crypto_engines": {
        "type": "int",
        "required": true
      },
      "engines": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "CryptoEngineEntry",
            "fields": {
              "state": {
                "type": "str",
                "required": true
              },
              "capabilities": {
                "type": {
                  "type": "list",
                  "items": "str"
                },
                "required": false
              },
              "ike_sessions": {
                "type": {
                  "name": "SessionCounters",
                  "fields": {
                    "active": {
                      "type": "int",
                      "required": true
                    },
                    "max": {
                      "type": "int",
                      "required": true
                    },
                    "failed": {
                      "type": "int",
                      "required": true
                    },
                    "created": {
                      "type": "int",
                      "required": true
                    }
                  }
                },
                "required": false
              },
              "ikev2_sessions": {
                "type": {
                  "type": "ref",
                  "name": "SessionCounters"
                },
                "required": false
              },
              "ipsec_sessions": {
                "type": {
                  "type": "ref",
                  "name": "SessionCounters"
                },
                "required": false
              },
              "dh_sessions": {
                "type": {
                  "name": "DHSessionCounters",
                  "fields": {
                    "active": {
                      "type": "int",
                      "required": true
                    },
                    "active_phase1": {
                      "type": "int",
                      "required": true
                    },
                    "active_phase2": {
                      "type": "int",
                      "required": true
                    },
                    "max": {
                      "type": "int",
                      "required": true
                    },
                    "failed": {
                      "type": "int",
                      "required": true
                    },
                    "created": {
                      "type": "int",
                      "required": true
                    }
                  }
                },
                "required": false
              },
              "ssl_support": {
                "type": "bool",
                "required": false
              },
              "ssl_versions": {
                "type": {
                  "type": "list",
                  "items": "str"
                },
                "required": false
              },
              "max_ssl_connections": {
                "type": "int",
                "required": false
              },
              "ssl_namespace": {
                "type": "int",
                "required": false
              },
              "cipher_suites": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "type": "list",
                    "items": "str"
                  }
                },
                "required": false
              },
              "dh_usage": {
                "type": {
                  "name": "DHUsage",
                  "fields": {
                    "in_use": {
                      "type": "int",
                      "required": true
                    },
                    "freeing": {
                      "type": "int",
                      "required": true
                    },
                    "free": {
                      "type": "int",
                      "required": true
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      },
      "dh_pregeneration": {
        "type": {
          "name": "DHPregeneration",
          "fields": {
            "count": {
              "type": "int",
              "required": true
            },
            "lifetime_seconds": {
              "type": "int",
              "required": true
            },
            "calculations": {
              "type": {
                "name": "DHCalculations",
                "fields": {
                  "p1": {
                    "type": "int",
                    "required": true
                  },
                  "ss": {
                    "type": "int",
                    "required": true
                  }
                }
              },
              "required": false
            }
          }
        },
        "required": false
      }
    }
  },
  "examples": [
