{
  "os": "cisco_iosxe",
  "command": "show ip ospf database asbr-summary",
  "schema": {
    "name": "ShowIpOspfDatabaseAsbrSummaryResult",
    "fields": {
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "areas": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "AreaEntry",
                    "fields": {
                      "lsas": {
                        "type": {
                          "type": "dict",
                          "key": "str",
                          "value": {
                            "type": "dict",
                            "key": "str",
                            "value": {
                              "name": "AsbrSummaryLsaEntry",
                              "fields": {
                                "ls_age": {
                                  "type": "int",
                                  "required": true
                                },
                                "options": {
                                  "type": "str",
                                  "required": true
                                },
                                "ls_type": {
                                  "type": "str",
                                  "required": true
                                },
                                "link_state_id": {
                                  "type": "str",
                                  "required": true
                                },
                                "advertising_router": {
                                  "type": "str",
                                  "required": true
                                },
                                "ls_seq_number": {
                                  "type": "str",
                                  "required": true
                                },
                                "checksum": {
                                  "type": "str",
                                  "required": true
                                },
                                "length": {
                                  "type": "int",
                                  "required": true
                                },
                                "network_mask": {
                                  "type": "str",
                                  "required": true
                                },
                                "tos": {
                                  "type": "int",
                                  "required": false
                                },
                                "metric": {
                                  "type": "int",
                                  "required": false
                                }
                              }
                            }
                          }
                        },
                        "required": true
                      }
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "OSPF ASBR summary database with multiple processes and no LSA entries",
      "input": "OSPF Router with ID (192.0.2.3) (Process ID 1)\n\n            OSPF Router with ID (203.0.113.3) (Process ID 20)\n\n            OSPF Router with ID (198.51.100.3) (Process ID 10)\n",
      "expected": {
        "processes": {
          "1": {
            "router_id": "192.0.2.3"
          },
          "20": {
            "router_id": "203.0.113.3"
          },
          "10": {
            "router_id": "198.51.100.3"
          }
        }
      }
    }
  ]
}
