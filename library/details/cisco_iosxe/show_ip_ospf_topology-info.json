{
  "os": "cisco_iosxe",
  "command": "show ip ospf topology-info",
  "schema": {
    "name": "ShowIpOspfTopologyInfoResult",
    "fields": {
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "topology": {
                "type": {
                  "name": "TopologyEntry",
                  "fields": {
                    "mtid": {
                      "type": "int",
                      "required": true
                    },
                    "topology_priority": {
                      "type": "int",
                      "required": true
                    },
                    "originating_max_metric": {
                      "type": "bool",
                      "required": true
                    },
                    "num_transit_capable_areas": {
                      "type": "int",
                      "required": true
                    },
                    "spf_timers": {
                      "type": {
                        "name": "SpfTimers",
                        "fields": {
                          "initial_delay_ms": {
                            "type": "int",
                            "required": true
                          },
                          "min_hold_ms": {
                            "type": "int",
                            "required": true
                          },
                          "max_wait_ms": {
                            "type": "int",
                            "required": true
                          }
                        }
                      },
                      "required": true
                    },
                    "areas": {
                      "type": {
                        "type": "dict",
                        "key": "str",
                        "value": {
                          "name": "AreaEntry",
                          "fields": {
                            "spf_last_executed": {
                              "type": "str",
                              "required": false
                            },
                            "spf_executions": {
                              "type": "int",
                              "required": false
                            }
                          }
                        }
                      },
                      "required": false
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
