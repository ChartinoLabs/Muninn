{
  "os": "cisco_iosxe",
  "command": "show macdb summary",
  "schema": {
    "name": "ShowMacdbSummaryResult",
    "fields": {
      "clients": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ClientCounter",
            "fields": {
              "count": {
                "type": "int",
                "required": true
              },
              "failures": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": true
      },
      "software": {
        "type": {
          "name": "TableCounters",
          "fields": {
            "interfaces": {
              "type": "int",
              "required": true
            },
            "mac_addresses": {
              "type": "int",
              "required": true
            },
            "forwarding_entities": {
              "type": "int",
              "required": true
            },
            "active_count": {
              "type": "int",
              "required": true
            }
          }
        },
        "required": true
      },
      "hardware": {
        "type": {
          "type": "ref",
          "name": "TableCounters"
        },
        "required": true
      },
      "platform": {
        "type": {
          "name": "PlatformCounters",
          "fields": {
            "mac_reserve_count": {
              "type": "int",
              "required": true
            },
            "mac_reserve_fail": {
              "type": "int",
              "required": true
            },
            "mac_active_count": {
              "type": "int",
              "required": true
            },
            "mac_smf_count": {
              "type": "int",
              "required": true
            }
          }
        },
        "required": true
      },
      "registered_clients_count": {
        "type": "int",
        "required": true
      },
      "registered_clients": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "RegisteredClient",
            "fields": {
              "id": {
                "type": "int",
                "required": true
              },
              "software": {
                "type": {
                  "name": "ClientForwarding",
                  "fields": {
                    "forwarding_entities": {
                      "type": "int",
                      "required": true
                    },
                    "active_count": {
                      "type": "int",
                      "required": true
                    }
                  }
                },
                "required": true
              },
              "hardware": {
                "type": {
                  "type": "ref",
                  "name": "ClientForwarding"
                },
                "required": true
              }
            }
          }
        },
        "required": false
      }
    }
  },
  "examples": [
    {
