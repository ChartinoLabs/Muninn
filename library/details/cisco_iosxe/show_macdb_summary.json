          "mac_addresses": 0,
          "forwarding_entities": 0,
          "active_count": 0
        },
        "hardware": {
          "interfaces": 0,
          "mac_addresses": 0,
          "forwarding_entities": 0,
          "active_count": 0
        },
        "platform": {
          "mac_reserve_count": 0,
          "mac_reserve_fail": 0,
          "mac_active_count": 0,
          "mac_smf_count": 0
        },
        "registered_clients_count": 1,
        "registered_clients": {
          "VRRS": {
