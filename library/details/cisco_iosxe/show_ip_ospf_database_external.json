{
  "os": "cisco_iosxe",
  "command": "show ip ospf database external",
  "schema": {
    "name": "ShowIpOspfDatabaseExternalResult",
    "fields": {
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "process_id": {
                "type": "int",
                "required": true
              },
              "lsas": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "type": "dict",
                    "key": "str",
                    "value": {
                      "name": "ExternalLsaEntry",
                      "fields": {
                        "ls_age": {
                          "type": "int",
                          "required": true
                        },
                        "options": {
                          "type": "str",
                          "required": true
                        },
                        "ls_type": {
                          "type": "str",
                          "required": true
                        },
                        "link_state_id": {
                          "type": "str",
                          "required": true
                        },
                        "advertising_router": {
                          "type": "str",
                          "required": true
                        },
                        "ls_seq_number": {
                          "type": "str",
                          "required": true
                        },
                        "checksum": {
                          "type": "str",
                          "required": true
                        },
                        "length": {
                          "type": "int",
                          "required": true
                        },
                        "network_mask": {
                          "type": "str",
                          "required": true
                        },
                        "metric_type": {
                          "type": "int",
                          "required": true
                        },
                        "metric": {
                          "type": "int",
                          "required": true
                        },
                        "forward_address": {
                          "type": "str",
                          "required": true
                        },
                        "external_route_tag": {
                          "type": "int",
                          "required": false
                        }
                      }
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Multiple OSPF processes with empty external LSA database",
      "input": "OSPF Router with ID (192.0.2.3) (Process ID 1)\n\n            OSPF Router with ID (203.0.113.3) (Process ID 20)\n\n            OSPF Router with ID (198.51.100.3) (Process ID 10)\n",
      "expected": {
        "processes": {
          "1": {
            "router_id": "192.0.2.3",
            "process_id": 1
          },
          "20": {
            "router_id": "203.0.113.3",
            "process_id": 20
          },
          "10": {
            "router_id": "198.51.100.3",
            "process_id": 10
          }
        }
      }
    }
  ]
}
