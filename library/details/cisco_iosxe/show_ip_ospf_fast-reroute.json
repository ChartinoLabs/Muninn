{
  "os": "cisco_iosxe",
  "command": "show ip ospf fast-reroute",
  "schema": {
    "name": "ShowIpOspfFastRerouteResult",
    "fields": {
      "processes": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ProcessEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "configured": {
                "type": "bool",
                "required": true
              },
              "areas": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "AreaFrrEntry",
                    "fields": {
                      "topology": {
                        "type": "str",
                        "required": false
                      },
                      "tiebreakers": {
                        "type": {
                          "type": "dict",
                          "key": "str",
                          "value": {
                            "name": "TiebreakerEntry",
                            "fields": {
                              "index": {
                                "type": "int",
                                "required": true
                              },
                              "enabled": {
                                "type": "bool",
                                "required": true
                              }
                            }
                          }
                        },
                        "required": false
                      }
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Show ip ospf fast-reroute output with multiple processes, none configured",
      "input": "OSPF Router with ID (192.0.2.3) (Process ID 1)\n\nLoop-free Fast Reroute not configured.\n\n\n            OSPF Router with ID (203.0.113.3) (Process ID 20)\n\nLoop-free Fast Reroute not configured.\n\n\n            OSPF Router with ID (198.51.100.3) (Process ID 10)\n\nLoop-free Fast Reroute not configured.\n",
      "expected": {
        "processes": {
          "1": {
            "router_id": "192.0.2.3",
            "configured": false
          },
          "20": {
            "router_id": "203.0.113.3",
            "configured": false
          },
          "10": {
            "router_id": "198.51.100.3",
            "configured": false
          }
        }
      }
    }
  ]
}
