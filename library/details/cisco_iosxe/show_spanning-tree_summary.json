{
  "os": "cisco_iosxe",
  "command": "show spanning-tree summary",
  "schema": {
    "name": "ShowSpanningTreeSummaryResult",
    "fields": {
      "mode": {
        "type": "str",
        "required": true
      },
      "root_bridge_for": {
        "type": {
          "type": "list",
          "items": "str"
        },
        "required": true
      },
      "defaults": {
        "type": {
          "name": "StpDefaults",
          "fields": {
            "etherchannel_misconfig_guard": {
              "type": "str",
              "required": false
            },
            "extended_system_id": {
              "type": "str",
              "required": false
            },
            "portfast_default": {
              "type": "str",
              "required": false
            },
            "portfast_bpdu_guard_default": {
              "type": "str",
              "required": false
            },
            "portfast_bpdu_filter_default": {
              "type": "str",
              "required": false
            },
            "portfast_edge_bpdu_guard_default": {
              "type": "str",
              "required": false
            },
            "portfast_edge_bpdu_filter_default": {
              "type": "str",
              "required": false
            },
            "loopguard_default": {
              "type": "str",
              "required": false
            },
            "pvst_simulation_default": {
              "type": "str",
              "required": false
            },
            "bridge_assurance": {
              "type": "str",
              "required": false
            },
            "bpdu_sender_conflict": {
              "type": "str",
              "required": false
            },
            "uplinkfast": {
              "type": "str",
              "required": false
            },
            "backbonefast": {
              "type": "str",
              "required": false
            }
          }
        },
        "required": true
      },
      "pathcost_method": {
        "type": "str",
        "required": false
      },
      "vlans": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "VlanCounts",
            "fields": {
              "blocking": {
                "type": "int",
                "required": true
              },
              "listening": {
                "type": "int",
                "required": true
              },
              "learning": {
                "type": "int",
                "required": true
              },
              "forwarding": {
                "type": "int",
                "required": true
              },
              "stp_active": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": true
      },
      "summary": {
        "type": {
          "name": "VlanSummary",
          "fields": {
            "total_vlans": {
              "type": "int",
              "required": true
            },
            "blocking": {
              "type": "int",
              "required": true
            },
            "listening": {
              "type": "int",
              "required": true
            },
            "learning": {
              "type": "int",
              "required": true
            },
            "forwarding": {
              "type": "int",
              "required": true
            },
            "stp_active": {
              "type": "int",
              "required": true
            }
          }
        },
        "required": false
      }
    }
  },
  "examples": [
    {
      "name": "show spanning-tree summary from an ISR 1100 (TAC-R2) with no VLANs/STP active",
      "input": "Switch is in rapid-pvst mode\nRoot bridge for: none\nExtended system ID                      is enabled\nPortfast Default                        is disabled\nPortFast BPDU Guard Default            is disabled\nPortfast BPDU Filter Default           is disabled\nLoopguard Default                      is disabled\nEtherChannel misconfig guard            is enabled\nUplinkFast                              is disabled\nBackboneFast                            is disabled\nConfigured Pathcost method used is short\n\nName                   Blocking Listening Learning Forwarding STP Active\n---------------------- -------- --------- -------- ---------- ----------\nTotal                        0         0        0          0          0\n",
      "expected": {
        "defaults": {
          "extended_system_id": "enabled",
          "portfast_default": "disabled",
          "portfast_bpdu_guard_default": "disabled",
          "portfast_bpdu_filter_default": "disabled",
          "loopguard_default": "disabled",
          "etherchannel_misconfig_guard": "enabled",
          "uplinkfast": "disabled",
          "backbonefast": "disabled"
        },
        "vlans": {},
        "mode": "rapid-pvst",
        "root_bridge_for": [],
        "pathcost_method": "short",
        "summary": {
          "total_vlans": 0,
          "blocking": 0,
          "listening": 0,
          "learning": 0,
          "forwarding": 0,
          "stp_active": 0
        }
      }
    },
    {
      "name": "show spanning-tree summary from a Catalyst 9300 (TAC-S1) acting as root bridge for VLAN 1",
      "input": "Switch is in rapid-pvst mode\nRoot bridge for: VLAN0001\nExtended system ID                      is enabled\nPortfast Default                        is disabled\nPortfast Edge BPDU Guard Default        is disabled\nPortfast Edge BPDU Filter Default       is disabled\nLoopguard Default                       is disabled\nBPDU sender conflict                    is enabled\nPVST Simulation Default                 is enabled but inactive in rapid-pvst\nmode\nBridge Assurance                        is disabled\nEtherChannel misconfig guard            is enabled\nUplinkFast                              is disabled\nBackboneFast                            is disabled\nConfigured Pathcost method used is long\n\nName                   Blocking Listening Learning Forwarding STP Active\n---------------------- -------- --------- -------- ---------- ----------\nVLAN0001                     0         0        0          1          1\n---------------------- -------- --------- -------- ---------- ----------\n1 vlan                       0         0        0          1          1\n",
      "expected": {
        "defaults": {
          "extended_system_id": "enabled",
          "portfast_default": "disabled",
          "portfast_edge_bpdu_guard_default": "disabled",
          "portfast_edge_bpdu_filter_default": "disabled",
          "loopguard_default": "disabled",
          "bpdu_sender_conflict": "enabled",
          "pvst_simulation_default": "enabled but inactive in rapid-pvst mode",
          "bridge_assurance": "disabled",
          "etherchannel_misconfig_guard": "enabled",
          "uplinkfast": "disabled",
          "backbonefast": "disabled"
        },
        "vlans": {
          "1": {
            "blocking": 0,
            "listening": 0,
            "learning": 0,
            "forwarding": 1,
            "stp_active": 1
          }
        },
        "mode": "rapid-pvst",
        "root_bridge_for": [
          "1"
        ],
        "pathcost_method": "long",
        "summary": {
          "total_vlans": 1,
          "blocking": 0,
          "listening": 0,
          "learning": 0,
          "forwarding": 1,
          "stp_active": 1
        }
      }
    }
  ]
}
