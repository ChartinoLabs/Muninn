{
  "os": "cisco_ftd",
  "command": "show arp",
  "schema": {
    "name": "ShowArpResult",
    "fields": {
      "arp_entries": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ArpEntry",
            "fields": {
              "interface": {
                "type": "str",
                "required": true
              },
              "mac_address": {
                "type": "str",
                "required": true
              },
              "age": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Basic show arp output from FTD with HA, Inside, and outside interfaces",
      "input": "\tHA 192.168.1.2 b2c3.d4e5.f601 610\n\tInside 172.16.1.3 b2c3.d4e5.f602 363\n\tInside 172.16.1.4 b2c3.d4e5.f603 363\n\tInside 172.16.1.1 b2c3.d4e5.f604 363\n\tInside 172.16.1.2 b2c3.d4e5.f605 363\n\toutside 172.16.2.134 b2c3.d4e5.f606 577\n\toutside 172.16.2.133 b2c3.d4e5.f607 591\n\toutside 172.16.2.135 b2c3.d4e5.f608 591\n",
      "expected": {
        "arp_entries": {
          "192.168.1.2": {
            "interface": "HA",
            "mac_address": "b2c3.d4e5.f601",
            "age": 610
          },
          "172.16.1.3": {
            "interface": "Inside",
            "mac_address": "b2c3.d4e5.f602",
            "age": 363
          },
          "172.16.1.4": {
            "interface": "Inside",
            "mac_address": "b2c3.d4e5.f603",
            "age": 363
          },
          "172.16.1.1": {
            "interface": "Inside",
            "mac_address": "b2c3.d4e5.f604",
            "age": 363
          },
          "172.16.1.2": {
            "interface": "Inside",
            "mac_address": "b2c3.d4e5.f605",
            "age": 363
          },
          "172.16.2.134": {
            "interface": "outside",
            "mac_address": "b2c3.d4e5.f606",
            "age": 577
          },
          "172.16.2.133": {
            "interface": "outside",
            "mac_address": "b2c3.d4e5.f607",
            "age": 591
          },
          "172.16.2.135": {
            "interface": "outside",
            "mac_address": "b2c3.d4e5.f608",
            "age": 591
          }
        }
