                "type": "str",
                "required": true
              },
              "poll": {
                "type": "int",
                "required": true
              },
              "reach": {
                "type": "str",
                "required": true
              },
              "offset_ms": {
                "type": "float",
                "required": true
              },
              "router": {
                "type": "str",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
