{
  "os": "arista_eos",
  "command": "show ip arp",
  "schema": {
    "name": "ShowIpArpResult",
    "fields": {
      "arp_entries": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "ArpEntry",
            "fields": {
              "mac_address": {
                "type": "str",
                "required": true
              },
              "age": {
                "type": "str",
                "required": true
              },
              "virtual_interface": {
                "type": "str",
                "required": false
              },
              "physical_interface": {
                "type": "str",
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Basic ARP entries with various interface types including port-channels",
      "input": "Address      Age (min) Hardware Addr  Interface\n172.25.0.2           0 004c.6211.021e Vlan101, Port-Channel2\n172.22.0.1           0 004c.6214.3699 Vlan1000, Port-Channel1\n172.22.0.2           0 004c.6219.a0f3 Ethernet1\n10.10.1.1          N/A 0002.00ff.0001 Vlan1, not learned\n",
      "expected": {
        "arp_entries": {
          "172.25.0.2": {
            "mac_address": "004c.6211.021e",
            "age": "0",
            "virtual_interface": "Vlan101",
            "physical_interface": "Port-channel2"
          },
          "172.22.0.1": {
            "mac_address": "004c.6214.3699",
            "age": "0",
            "virtual_interface": "Vlan1000",
            "physical_interface": "Port-channel1"
          },
          "172.22.0.2": {
            "mac_address": "004c.6219.a0f3",
            "age": "0",
            "physical_interface": "Ethernet1"
          },
          "10.10.1.1": {
            "mac_address": "0002.00ff.0001",
            "age": "N/A",
            "virtual_interface": "Vlan1"
          }
        }
      }
    },
    {
      "name": "ARP entries across multiple VRFs with age in seconds format",
      "input": "VRF: MGMT\nAddress         Age (sec)  Hardware Addr   Interface\n10.1.1.1          0:00:00  004c.6211.113e  Vlan1\n\nVRF: default\nAddress         Age (sec)  Hardware Addr   Interface\n172.16.0.1               0 004c.6211.223b  Vlan101, Port-Channel2\n172.16.0.2               0 004c.6214.333c  Vlan1000, Port-Channel1\n172.16.0.3               0 004c.6219.444d  Ethernet1\n10.10.1.1              N/A 0002.00ff.555e  Vlan1, not learned\n",
      "expected": {
        "arp_entries": {
          "10.1.1.1": {
            "mac_address": "004c.6211.113e",
            "age": "0:00:00",
            "virtual_interface": "Vlan1"
          },
          "172.16.0.1": {
            "mac_address": "004c.6211.223b",
            "age": "0",
            "virtual_interface": "Vlan101",
            "physical_interface": "Port-channel2"
          },
          "172.16.0.2": {
            "mac_address": "004c.6214.333c",
            "age": "0",
            "virtual_interface": "Vlan1000",
            "physical_interface": "Port-channel1"
          },
          "172.16.0.3": {
            "mac_address": "004c.6219.444d",
            "age": "0",
            "physical_interface": "Ethernet1"
          },
          "10.10.1.1": {
            "mac_address": "0002.00ff.555e",
            "age": "N/A",
            "virtual_interface": "Vlan1"
          }
        }
      }
    }
  ]
}
