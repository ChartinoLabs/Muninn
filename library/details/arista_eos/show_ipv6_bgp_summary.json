{
  "os": "arista_eos",
  "command": "show ipv6 bgp summary",
  "schema": {
    "name": "ShowIpv6BgpSummaryResult",
    "fields": {
      "vrfs": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "VrfEntry",
            "fields": {
              "router_id": {
                "type": "str",
                "required": true
              },
              "local_as": {
                "type": "str",
                "required": true
              },
              "neighbors": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "NeighborEntry",
                    "fields": {
                      "version": {
                        "type": "int",
                        "required": true
                      },
                      "remote_as": {
                        "type": "str",
                        "required": true
                      },
                      "msg_rcvd": {
                        "type": "int",
                        "required": true
                      },
                      "msg_sent": {
                        "type": "int",
                        "required": true
                      },
                      "in_queue": {
                        "type": "int",
                        "required": true
                      },
                      "out_queue": {
                        "type": "int",
                        "required": true
                      },
                      "up_down": {
                        "type": "str",
                        "required": true
                      },
                      "state": {
                        "type": "str",
                        "required": false
                      },
                      "prefix_received": {
                        "type": "int",
                        "required": false
                      },
                      "prefix_accepted": {
                        "type": "int",
                        "required": false
                      }
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Basic IPv6 BGP summary with two eBGP/iBGP neighbors",
      "input": "BGP router identifier 10.26.0.22, local AS number 65533\nNeighbor         V  AS      MsgRcvd   MsgSent  InQ OutQ  Up/Down State/PfxRcd\n2001:DB8:ff11::1    4  65534       187       191    0    0 02:49:40 7\n2001:DB8:ff12::2     4  65533       184       191    0    0 02:59:41 7\n",
      "expected": {
        "vrfs": {
          "default": {
            "router_id": "10.26.0.22",
            "local_as": "65533",
            "neighbors": {
              "2001:DB8:ff11::1": {
                "version": 4,
                "remote_as": "65534",
                "msg_rcvd": 187,
                "msg_sent": 191,
                "in_queue": 0,
                "out_queue": 0,
                "up_down": "02:49:40",
                "prefix_received": 7
              },
              "2001:DB8:ff12::2": {
                "version": 4,
                "remote_as": "65533",
                "msg_rcvd": 184,
                "msg_sent": 191,
                "in_queue": 0,
                "out_queue": 0,
                "up_down": "02:59:41",
                "prefix_received": 7
              }
            }
          }
        }
      }
    },
    {
      "name": "Single-VRF banner form with split State PfxRcd PfxAcc columns and non-Established states",
      "input": "BGP summary information for VRF default\nRouter identifier 10.0.65.72, local AS number 64911\nNeighbor Status Codes: m - Under maintenance\n  Neighbor         V  AS           MsgRcvd   MsgSent  InQ OutQ  Up/Down State  PfxRcd PfxAcc\n  2001:DB8:ffff::1      4  65292              0         0    0    0   79d05h Active\n  2001:DB8:fff1::1     4  64832              0         0    0    0   79d05h Idle(NoIf)\n  2001:DB8:fff2::1     4  64833         114056    118481    0    0   79d05h Estab  1      1\n",
      "expected": {
