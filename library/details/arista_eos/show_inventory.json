{
  "os": "arista_eos",
  "command": "show inventory",
  "schema": {
    "name": "ShowInventoryResult",
    "fields": {
      "system": {
        "type": {
          "name": "SystemInfo",
          "fields": {
            "description": {
              "type": "str",
              "required": true
            },
            "hardware_version": {
              "type": "str",
