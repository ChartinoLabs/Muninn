          "type": "dict",
          "key": "str",
          "value": {
            "name": "FanModuleEntry",
            "fields": {
              "num_fans": {
                "type": "int",
                "required": true
              },
              "model": {
                "type": "str",
                "required": true
              },
              "serial_number": {
                "type": "str",
                "required": false
              }
            }
          }
        },
        "required": true
      },
      "ports": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "PortSummaryEntry",
            "fields": {
              "count": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": true
      },
      "transceivers": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "TransceiverEntry",
            "fields": {
              "manufacturer": {
                "type": "str",
                "required": true
              },
              "model": {
                "type": "str",
                "required": true
              },
              "serial_number": {
                "type": "str",
                "required": false
              },
              "revision": {
                "type": "str",
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
