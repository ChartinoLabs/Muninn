{
  "os": "arista_eos",
  "command": "show vlan",
  "schema": {
    "name": "ShowVlanResult",
    "fields": {
      "vlans": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "VlanEntry",
            "fields": {
              "vlan_id": {
                "type": "int",
                "required": true
              },
              "name": {
                "type": "str",
                "required": true
              },
              "status": {
                "type": "str",
                "required": true
              },
              "ports": {
                "type": {
                  "type": "list",
                  "items": "str"
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Basic VLAN table with active and suspended VLANs",
      "input": "VLAN  Name                             Status    Ports\n----- -------------------------------- --------- -------------------------------\n1     default                          active    Et1\n10    Test1                            active    Et1, Et2\n20    Test2                            suspended\n30    VLAN0030                         suspended\n",
      "expected": {
        "vlans": {
          "1": {
            "vlan_id": 1,
            "name": "default",
            "status": "active",
            "ports": [
              "Ethernet1"
            ]
          },
          "10": {
            "vlan_id": 10,
            "name": "Test1",
            "status": "active",
            "ports": [
              "Ethernet1",
              "Ethernet2"
            ]
          },
          "20": {
            "vlan_id": 20,
            "name": "Test2",
            "status": "suspended",
            "ports": []
          },
          "30": {
            "vlan_id": 30,
            "name": "VLAN0030",
            "status": "suspended",
            "ports": []
          }
        }
      }
    },
    {
      "name": "VLAN table with a port list wrapped across continuation lines",
      "input": "VLAN  Name                             Status    Ports\n----- -------------------------------- --------- -------------------------------\n100   prod                             active    Et1, Et2, Et3, Et4, Et5, Et6,\n                                                 Et7, Et8, Et9\n200   mgmt                             active    Po10, Vx1\n",
      "expected": {
        "vlans": {
          "100": {
            "vlan_id": 100,
            "name": "prod",
            "status": "active",
            "ports": [
              "Ethernet1",
              "Ethernet2",
              "Ethernet3",
              "Ethernet4",
              "Ethernet5",
              "Ethernet6",
              "Ethernet7",
              "Ethernet8",
              "Ethernet9"
            ]
          },
          "200": {
            "vlan_id": 200,
            "name": "mgmt",
            "status": "active",
            "ports": [
              "Port-channel10",
              "Vx1"
            ]
          }
        }
      }
    }
  ]
}
