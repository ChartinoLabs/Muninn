{
  "os": "arista_eos",
  "command": "show ip interface brief",
  "schema": {
    "name": "ShowIpInterfaceBriefResult",
    "fields": {
      "interfaces": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "IpInterfaceBriefEntry",
            "fields": {
              "ip_address": {
                "type": "str",
                "required": false
              },
              "status": {
                "type": "str",
                "required": true
              },
              "protocol": {
                "type": "str",
                "required": true
              },
              "mtu": {
                "type": "int",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Basic IP interface brief with loopback, management, VLAN, ethernet, and port-channel",
      "input": "Interface              IP Address         Status     Protocol         MTU\nLoopback0              1.1.1.1/32         up         up             65535\nManagement1            unassigned         down       down            1500\nVlan10                 unassigned         down       lowerlayerdown  1500\nEthernet5              10.0.0.1/24        up         up              1500\nPort-Channel1          11.11.11.11/24     down       lowerlayerdown  1500\n",
      "expected": {
        "interfaces": {
          "Loopback0": {
            "ip_address": "1.1.1.1/32",
            "status": "up",
            "protocol": "up",
            "mtu": 65535
          },
          "Management1": {
            "status": "down",
            "protocol": "down",
            "mtu": 1500
          },
          "Vlan10": {
            "status": "down",
            "protocol": "lowerlayerdown",
            "mtu": 1500
          },
          "Ethernet5": {
            "ip_address": "10.0.0.1/24",
            "status": "up",
            "protocol": "up",
            "mtu": 1500
          },
          "Port-channel1": {
            "ip_address": "11.11.11.11/24",
            "status": "down",
            "protocol": "lowerlayerdown",
            "mtu": 1500
          }
        }
      }
    }
  ]
}
