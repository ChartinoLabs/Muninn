{
  "os": "arista_eos",
  "command": "show ip helper-address",
  "schema": {
    "name": "ShowIpHelperAddressResult",
    "fields": {
      "dhcp_relay": {
        "type": "bool",
        "required": true
      },
      "dhcp_relay_option_82": {
        "type": "bool",
        "required": true
      },
      "dhcpv6_relay_link_layer_option_79": {
        "type": "bool",
        "required": true
      },
      "dhcp_smart_relay": {
        "type": "bool",
        "required": true
      },
      "interfaces": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "HelperAddressEntry",
            "fields": {
              "dhcp_smart_relay": {
                "type": "bool",
                "required": true
              },
              "dhcp_servers": {
                "type": {
                  "type": "list",
                  "items": "str"
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "DHCP relay with multiple helper addresses across two VLANs",
      "input": "DHCP Relay is active\nDHCP Relay Option 82 is disabled\nDHCPv6 Relay Link-layer Address Option (79) is disabled\nDHCP Smart Relay is disabled\nInterface: Vlan1\n  DHCP Smart Relay is disabled\n  DHCP servers: 10.1.0.0\n                10.1.0.1\n                10.1.0.2\n                10.1.0.3\n                server.domain\nInterface: Vlan2\n  DHCP Smart Relay is disabled\n  DHCP servers: 10.1.0.4\n                server.domain\n",
      "expected": {
        "dhcp_relay": true,
        "dhcp_relay_option_82": false,
        "dhcpv6_relay_link_layer_option_79": false,
        "dhcp_smart_relay": false,
        "interfaces": {
          "Vlan1": {
            "dhcp_smart_relay": false,
            "dhcp_servers": [
              "10.1.0.0",
              "10.1.0.1",
              "10.1.0.2",
              "10.1.0.3",
              "server.domain"
            ]
          },
          "Vlan2": {
            "dhcp_smart_relay": false,
            "dhcp_servers": [
              "10.1.0.4",
              "server.domain"
            ]
          }
        }
      }
    }
  ]
}
