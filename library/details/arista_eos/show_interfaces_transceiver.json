{
  "os": "arista_eos",
  "command": "show interfaces transceiver",
  "schema": {
    "name": "ShowInterfacesTransceiverResult",
    "fields": {
      "interfaces": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "TransceiverEntry",
            "fields": {
              "temperature_c": {
                "type": "float",
                "required": false
              },
              "voltage_v": {
                "type": "float",
                "required": false
              },
              "current_ma": {
                "type": "float",
                "required": false
              },
              "tx_power_dbm": {
                "type": "float",
                "required": false
              },
              "rx_power_dbm": {
                "type": "float",
                "required": false
              },
              "last_update": {
                "type": "str",
                "required": false
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
