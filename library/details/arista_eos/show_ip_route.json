              "type_code": {
                "type": "str",
                "required": false
              },
              "next_hops": {
                "type": {
                  "type": "list",
                  "items": {
                    "name": "NextHopEntry",
                    "fields": {
                      "next_hop": {
                        "type": "str",
                        "required": false
                      },
                      "outgoing_interface": {
                        "type": "str",
                        "required": false
                      },
                      "admin_distance": {
                        "type": "int",
                        "required": false
                      },
                      "metric": {
                        "type": "int",
                        "required": false
                      }
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
