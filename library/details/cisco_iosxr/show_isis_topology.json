{
  "os": "cisco_iosxr",
  "command": "show isis topology",
  "schema": {
    "name": "ShowIsisTopologyResult",
    "fields": {
      "instances": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "type": "dict",
            "key": "str",
            "value": {
              "type": "dict",
              "key": "str",
              "value": {
                "name": "IsisTopologySystem",
                "fields": {
                  "is_local": {
                    "type": "bool",
                    "required": true
                  },
                  "paths": {
                    "type": {
                      "type": "dict",
                      "key": "str",
                      "value": {
                        "name": "IsisTopologyPath",
                        "fields": {
                          "metric": {
                            "type": "int",
                            "required": true
                          },
                          "next_hop": {
                            "type": "str",
                            "required": true
                          },
                          "snpa": {
                            "type": "str",
                            "required": true
                          }
                        }
                      }
                    },
                    "required": true
                  }
                }
              }
            }
          }
        },
        "required": true
      },
      "total_path_count": {
        "type": "int",
        "required": false
      }
    }
  },
