{
  "os": "cisco_iosxr",
  "command": "show isis neighbors",
  "schema": {
    "name": "ShowIsisNeighborsResult",
    "fields": {
      "instances": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "type": "dict",
            "key": "str",
            "value": {
              "type": "dict",
              "key": "str",
              "value": {
                "name": "IsisNeighborEntry",
                "fields": {
                  "snpa": {
                    "type": "str",
                    "required": true
                  },
                  "state": {
                    "type": "str",
                    "required": true
                  },
                  "holdtime": {
                    "type": "int",
                    "required": true
                  },
                  "neighbor_type": {
                    "type": "str",
                    "required": true
                  },
                  "ietf_nsf": {
                    "type": "str",
                    "required": false
                  }
                }
              }
            }
          }
        },
        "required": true
      },
      "total_neighbor_count": {
        "type": "int",
        "required": false
      }
    }
  },
  "examples": [
    {
      "name": "Multiple IS-IS neighbors with mixed types and IETF-NSF capabilities",
      "input": "Tue Jan  3 14:57:35.234 UTC\n\nIS-IS 1 neighbors:\nSystem Id      Interface        SNPA           State Holdtime Type IETF-NSF\nCSR2           Gi0/0/0/1        5000.0002.0001 Up    23       L1L2 Capable\nvMX1           Gi0/0/0/1        0005.8671.9202 Up    18       L1L2 Capable\nvMX1           Gi0/0/0/3        *PtoP*         Up    25       L1L2 Capable\nvEOS4          Gi0/0/0/2        5000.0003.3766 Up    8        L2   Unable\n\nTotal neighbor count: 4\n",
      "expected": {
        "instances": {
          "1": {
            "CSR2": {
              "GigabitEthernet0/0/0/1": {
                "snpa": "5000.0002.0001",
                "state": "Up",
                "holdtime": 23,
                "neighbor_type": "L1L2",
                "ietf_nsf": "Capable"
              }
            },
            "vMX1": {
              "GigabitEthernet0/0/0/1": {
                "snpa": "0005.8671.9202",
                "state": "Up",
                "holdtime": 18,
                "neighbor_type": "L1L2",
                "ietf_nsf": "Capable"
              },
              "GigabitEthernet0/0/0/3": {
                "snpa": "*PtoP*",
                "state": "Up",
                "holdtime": 25,
                "neighbor_type": "L1L2",
                "ietf_nsf": "Capable"
              }
            },
            "vEOS4": {
              "GigabitEthernet0/0/0/2": {
                "snpa": "5000.0003.3766",
                "state": "Up",
                "holdtime": 8,
                "neighbor_type": "L2",
                "ietf_nsf": "Unable"
              }
            }
          }
        },
        "total_neighbor_count": 4
      }
    }
  ]
}
