        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "type": "dict",
            "key": "str",
            "value": {
              "name": "Xconnect",
              "fields": {
                "state": {
                  "type": "str",
                  "required": true
                },
                "partially_programmed": {
                  "type": "bool",
                  "required": false
                },
                "seamless_inactive": {
                  "type": "bool",
                  "required": false
                },
                "segment_1": {
                  "type": {
                    "name": "Segment",
