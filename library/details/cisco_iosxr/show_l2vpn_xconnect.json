                      "state": {
                        "type": "str",
                        "required": true
                      },
                      "partially_programmed": {
                        "type": "bool",
                        "required": false
                      },
                      "seamless_inactive": {
                        "type": "bool",
                        "required": false
                      },
                      "interface": {
                        "type": "str",
                        "required": false
                      },
                      "neighbor": {
                        "type": "str",
                        "required": false
                      },
                      "pw_id": {
                        "type": "int",
                        "required": false
                      },
                      "evi": {
                        "type": "int",
                        "required": false
                      },
                      "ac_id": {
                        "type": "int",
                        "required": false
                      },
                      "description": {
                        "type": "str",
                        "required": false
                      }
                    }
                  },
                  "required": true
                },
                "segment_2": {
                  "type": {
                    "type": "ref",
                    "name": "Segment"
                  },
                  "required": true
                }
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "Single AC-PW xconnect with group and name on one line, extended legend and command echo",
      "input": "\nshow l2vpn xconnect\n\nFri Sep 27 17:02:50.459 EDT\nLegend: ST = State, UP = Up, DN = Down, AD = Admin Down, UR = Unresolved,\n        SB = Standby, SR = Standby Ready, (PP) = Partially Programmed,\n        LU = Local Up, RU = Remote Up, CO = Connected\n\nXConnect                   Segment 1                       Segment 2\nGroup      Name       ST   Description            ST       Description            ST\n------------------------   -----------------------------   -----------------------------\nPW_XG      PW_TEST\n                      UP   Te0/0/0/0.1234         UP       10.60.1.1       12345  UP\n----------------------------------------------------------------------------------------\n",
      "expected": {
        "groups": {
          "PW_XG": {
            "PW_TEST": {
              "state": "up",
              "segment_1": {
                "state": "up",
                "interface": "TenGigabitEthernet0/0/0/0.1234"
              },
              "segment_2": {
                "state": "up",
                "neighbor": "10.60.1.1",
                "pw_id": 12345
              }
            }
          }
        }
      }
    },
    {
