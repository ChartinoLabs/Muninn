              "state": "down",
              "segment_1": {
                "state": "up",
                "interface": "PE104"
              },
              "segment_2": {
                "state": "down",
                "evi": 104,
                "ac_id": 104
              }
            }
          },
          "pa_evpn_he_106": {
            "pa_evpn_he_106": {
              "state": "down",
              "segment_1": {
                "state": "up",
                "interface": "PE106"
              },
              "segment_2": {
                "state": "down",
                "evi": 106,
                "ac_id": 106
              }
            }
          },
          "sa_evpn_he_105": {
            "sa_evpn_he_105": {
              "state": "down",
              "segment_1": {
                "state": "up",
                "interface": "PE105"
              },
              "segment_2": {
                "state": "down",
                "evi": 105,
                "ac_id": 105
              }
            }
