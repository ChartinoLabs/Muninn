              "table_state": {
                "type": "str",
                "required": false
              },
              "table_id": {
                "type": "str",
                "required": false
              },
              "rd_version": {
                "type": "int",
                "required": false
              },
              "main_routing_table_version": {
                "type": "int",
                "required": true
              },
              "nsr_initial_initsync_version": {
                "type": "str",
                "required": false
              },
              "nsr_issu_sync_group_versions": {
                "type": "str",
                "required": false
              },
              "scan_interval": {
                "type": "int",
                "required": false
              },
              "operation_mode": {
