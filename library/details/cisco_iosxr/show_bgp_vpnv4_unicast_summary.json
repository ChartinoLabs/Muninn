                      "type": "int",
                      "required": true
                    },
                    "label_ver": {
                      "type": "int",
                      "required": true
                    },
                    "import_ver": {
                      "type": "int",
                      "required": true
                    },
                    "send_tbl_ver": {
                      "type": "int",
                      "required": true
                    },
                    "standby_ver": {
                      "type": "int",
                      "required": true
                    }
                  }
                },
                "required": false
              },
              "neighbors": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "NeighborEntry",
                    "fields": {
                      "spk": {
                        "type": "int",
                        "required": true
                      },
                      "remote_as": {
                        "type": "str",
                        "required": true
                      },
                      "msg_rcvd": {
                        "type": "int",
                        "required": true
                      },
                      "msg_sent": {
                        "type": "int",
                        "required": true
                      },
                      "tbl_ver": {
                        "type": "int",
                        "required": true
                      },
                      "in_queue": {
                        "type": "int",
                        "required": true
                      },
                      "out_queue": {
                        "type": "int",
                        "required": true
                      },
                      "up_down": {
                        "type": "str",
                        "required": true
                      },
                      "state_pfxrcd": {
                        "type": "str",
                        "required": true
                      }
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
