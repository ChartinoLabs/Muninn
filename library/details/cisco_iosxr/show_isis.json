              },
              "te_connection_status": {
                "type": "str",
                "required": true
              },
              "xtc_connection_status": {
                "type": "str",
                "required": true
              },
              "overload_bit": {
                "type": "str",
                "required": true
              },
              "maximum_metric": {
                "type": "str",
                "required": true
              },
              "topologies": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "IsisTopology",
                    "fields": {
                      "rib_connected": {
                        "type": "bool",
                        "required": true
                      },
                      "levels": {
                        "type": {
                          "type": "dict",
                          "key": "str",
                          "value": {
                            "name": "IsisTopologyLevel",
                            "fields": {
                              "metric_style_generate": {
                                "type": "str",
                                "required": false
                              },
                              "metric_style_accept": {
                                "type": "str",
                                "required": false
                              },
                              "metric": {
                                "type": "int",
                                "required": true
                              },
                              "te_enabled": {
                                "type": "bool",
                                "required": false
                              }
                            }
                          }
                        },
                        "required": true
                      },
                      "redistributed_protocols": {
                        "type": {
                          "type": "list",
                          "items": "str"
                        },
                        "required": true
                      },
                      "distance": {
                        "type": "int",
                        "required": true
                      },
                      "advertise_passive_only": {
                        "type": "bool",
                        "required": true
                      }
                    }
                  }
                },
                "required": true
              },
              "sr_mpls": {
                "type": {
                  "name": "IsisSrMpls",
                  "fields": {
                    "srlb_start": {
                      "type": "int",
                      "required": true
                    },
                    "srlb_end": {
                      "type": "int",
                      "required": true
                    },
                    "srgb_start": {
                      "type": "int",
                      "required": true
                    },
                    "srgb_end": {
                      "type": "int",
                      "required": true
                    }
                  }
                },
                "required": false
              },
              "srv6": {
                "type": {
                  "name": "IsisSrv6",
                  "fields": {
                    "locators": {
                      "type": {
                        "type": "dict",
                        "key": "str",
                        "value": {
                          "name": "IsisSrv6Locator",
                          "fields": {
                            "status": {
                              "type": "str",
                              "required": true
                            }
                          }
                        }
                      },
                      "required": true
                    }
                  }
                },
                "required": false
              },
              "interfaces": {
                "type": {
                  "type": "dict",
                  "key": "str",
                  "value": {
                    "name": "IsisInterface",
                    "fields": {
                      "running_state": {
                        "type": "str",
                        "required": true
                      },
                      "config_state": {
                        "type": "str",
                        "required": true
                      }
                    }
                  }
                },
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
