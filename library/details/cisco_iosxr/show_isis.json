              },
              "is_levels": {
                "type": "str",
                "required": true
              },
              "manual_area_addresses": {
                "type": {
                  "type": "list",
                  "items": "str"
                },
                "required": true
              },
              "routing_area_addresses": {
                "type": {
                  "type": "list",
                  "items": "str"
                },
                "required": true
              },
              "multi_instance_id": {
                "type": "int",
                "required": true
              },
              "job_id": {
                "type": "int",
                "required": true
              },
              "pid": {
                "type": "int",
                "required": true
              },
              "respawn_count": {
                "type": "int",
                "required": true
              },
              "started": {
                "type": "str",
                "required": true
              },
              "null0_ready": {
                "type": "str",
                "required": true
              },
              "lsp_mtu": {
                "type": "int",
