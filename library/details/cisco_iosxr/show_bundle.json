          },
          "Bundle-Ether2": {
            "status": "Up",
            "local_links_active": 2,
            "local_links_standby": 1,
            "local_links_configured": 3,
            "local_bandwidth_effective_kbps": 2000000,
            "local_bandwidth_available_kbps": 2000000,
            "mac_address": "001b.0cff.6a34",
            "mac_address_source": "Chassis pool",
            "inter_chassis_link": false,
            "minimum_active_links": 2,
            "minimum_active_bandwidth_kbps": 1,
            "maximum_active_links": 2,
            "wait_while_timer_enabled": true,
            "wait_while_timer_ms": 2000,
            "load_balancing": {
              "link_order_signaling": "Not configured",
