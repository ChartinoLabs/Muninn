            },
            "mlacp": {
              "status": "Not configured"
            },
            "ipv4_bfd": {
              "status": "Not configured"
            },
            "ipv6_bfd": {
              "status": "Not configured"
            },
            "members": {
              "Local": {
                "GigabitEthernet0/0/0/2": {
                  "state": "Standby",
                  "port_priority": "0x8000",
                  "port_number": "0x0005",
                  "bandwidth_kbps": 1000000,
                  "state_reason": "Link is Standby due to maximum-active links configuration"
                },
                "GigabitEthernet0/0/0/3": {
                  "state": "Active",
                  "port_priority": "0x8000",
                  "port_number": "0x0004",
                  "bandwidth_kbps": 1000000,
