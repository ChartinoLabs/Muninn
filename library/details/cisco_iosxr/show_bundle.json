                    "type": "dict",
                    "key": "str",
                    "value": {
                      "name": "MemberEntry",
                      "fields": {
                        "state": {
                          "type": "str",
                          "required": true
                        },
                        "port_priority": {
                          "type": "str",
                          "required": true
                        },
                        "port_number": {
                          "type": "str",
                          "required": true
                        },
                        "bandwidth_kbps": {
                          "type": "int",
                          "required": true
                        },
                        "state_reason": {
                          "type": "str",
                          "required": false
                        }
                      }
                    }
                  }
                },
                "required": false
              }
            }
          }
        },
        "required": true
      }
