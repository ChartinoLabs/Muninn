                    },
                    "hash_type": {
                      "type": "str",
                      "required": false
                    }
                  }
                },
                "required": false
              },
              "lacp": {
                "type": {
                  "name": "LacpEntry",
                  "fields": {
                    "status": {
                      "type": "str",
                      "required": true
                    },
                    "flap_suppression_timer_enabled": {
                      "type": "bool",
                      "required": false
                    },
                    "flap_suppression_timer_ms": {
                      "type": "int",
                      "required": false
                    },
                    "cisco_extensions": {
                      "type": "bool",
                      "required": false
                    },
                    "non_revertive": {
                      "type": "bool",
                      "required": false
                    }
                  }
                },
                "required": false
              },
              "mlacp": {
                "type": {
                  "name": "MlacpEntry",
                  "fields": {
                    "status": {
                      "type": "str",
                      "required": true
                    },
                    "iccp_group": {
                      "type": "int",
                      "required": false
                    },
                    "role": {
                      "type": "str",
                      "required": false
                    },
                    "foreign_links_active": {
                      "type": "int",
                      "required": false
                    },
                    "foreign_links_configured": {
                      "type": "int",
                      "required": false
                    },
                    "switchover_type": {
                      "type": "str",
                      "required": false
                    },
                    "recovery_delay_seconds": {
                      "type": "int",
                      "required": false
                    },
                    "maximize_threshold": {
                      "type": "str",
                      "required": false
                    }
                  }
                },
                "required": false
              },
              "ipv4_bfd": {
                "type": {
                  "name": "BfdEntry",
                  "fields": {
                    "status": {
                      "type": "str",
                      "required": true
                    }
