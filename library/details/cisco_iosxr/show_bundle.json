              "local_links_configured": {
                "type": "int",
                "required": true
              },
              "local_bandwidth_effective_kbps": {
                "type": "int",
                "required": false
              },
              "local_bandwidth_available_kbps": {
                "type": "int",
                "required": false
              },
              "mac_address": {
                "type": "str",
                "required": false
              },
              "mac_address_source": {
                "type": "str",
                "required": false
              },
              "inter_chassis_link": {
                "type": "bool",
                "required": false
              },
              "minimum_active_links": {
                "type": "int",
                "required": false
              },
              "minimum_active_bandwidth_kbps": {
                "type": "int",
                "required": false
              },
              "maximum_active_links": {
                "type": "int",
                "required": false
