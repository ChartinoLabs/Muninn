            "value": {
              "name": "PimNeighborEntry",
              "fields": {
                "interface": {
                  "type": "str",
                  "required": true
                },
                "uptime": {
                  "type": "str",
                  "required": true
                },
                "expires": {
                  "type": "str",
                  "required": true
