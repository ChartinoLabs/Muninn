{
  "os": "cisco_iosxr",
  "command": "show evpn evi",
  "schema": {
    "name": "ShowEvpnEviResult",
    "fields": {
      "evi_entries": {
        "type": {
          "type": "dict",
          "key": "str",
          "value": {
            "name": "EvpnEviEntry",
            "fields": {
              "encapsulation": {
                "type": "str",
                "required": false
              },
              "bridge_domain": {
                "type": "str",
                "required": true
              },
              "evi_type": {
                "type": "str",
                "required": true
              }
            }
          }
        },
        "required": true
      }
    }
  },
  "examples": [
    {
      "name": "EVPN EVI summary with multiple MPLS-encapsulated EVIs and ES:GLOBAL entry",
      "input": "Tue Jul  7 22:59:32.847 EDT\n\nVPN-ID     Encap      Bridge Domain                Type\n---------- ---------- ---------------------------- -------------------\n22         MPLS       22                           EVPN\n56         MPLS       56                           EVPN\n1010       MPLS       1010                         EVPN\n65535      N/A        ES:GLOBAL                    Invalid\n",
      "expected": {
        "evi_entries": {
          "22": {
            "encapsulation": "MPLS",
            "bridge_domain": "22",
            "evi_type": "EVPN"
          },
          "56": {
            "encapsulation": "MPLS",
            "bridge_domain": "56",
            "evi_type": "EVPN"
          },
          "1010": {
            "encapsulation": "MPLS",
            "bridge_domain": "1010",
            "evi_type": "EVPN"
          },
          "65535": {
            "bridge_domain": "ES:GLOBAL",
            "evi_type": "Invalid"
          }
        }
      }
    }
  ]
}
